# Copy to .env and fill in:  cp env.example .env
#
# Every value here has a working default except the LLM key, so the only line
# you strictly need is ATELIER_GROQ_API_KEY. Retrieval and web search both run
# key-free out of the box.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# One of: groq | openai | anthropic
ATELIER_LLM_PROVIDER=groq

# Groq (default — free tier, https://console.groq.com/keys)
ATELIER_GROQ_API_KEY=
ATELIER_GROQ_MODEL=openai/gpt-oss-120b
# Groq has no vision model today; scanned-PDF and image OCR needs
# ATELIER_LLM_PROVIDER=openai or anthropic.
ATELIER_GROQ_VISION_MODEL=openai/gpt-oss-120b

# OpenAI (ATELIER_LLM_PROVIDER=openai)
ATELIER_OPENAI_API_KEY=
ATELIER_OPENAI_MODEL=gpt-4.1-mini
ATELIER_OPENAI_VISION_MODEL=gpt-4.1-mini

# Anthropic (ATELIER_LLM_PROVIDER=anthropic)
ATELIER_ANTHROPIC_API_KEY=
ATELIER_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ATELIER_ANTHROPIC_VISION_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Vector store (enterprise RAG)
# ---------------------------------------------------------------------------
# chroma   = local, embedded, no account needed (default)
# pinecone = managed; also run `pip install pinecone`
ATELIER_VECTOR_BACKEND=chroma
ATELIER_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

ATELIER_PINECONE_API_KEY=
ATELIER_PINECONE_INDEX=atelier
ATELIER_PINECONE_CLOUD=aws
ATELIER_PINECONE_REGION=us-east-1

# ---------------------------------------------------------------------------
# Web research
# ---------------------------------------------------------------------------
# duckduckgo = keyless (default) | tavily = better results, needs a key
ATELIER_SEARCH_PROVIDER=duckduckgo
ATELIER_TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
ATELIER_DATA_DIR=./data
ATELIER_LOG_LEVEL=INFO

# Optional shared secret. When set, every /api request must send
# `X-API-Key: <value>`. Leave blank for local development.
ATELIER_API_KEY=

# Comma-separated. Localhost only by default.
ATELIER_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
